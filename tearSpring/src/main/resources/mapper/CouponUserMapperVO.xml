<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guchen.mapper.CouponUserMapperVO">

    <resultMap id="BaseResultMap" type="com.guchen.pojo.CouponUserVO">
            <id property="id" column="id" />
            <result property="name" column="name" />
            <result property="value" column="value" />
            <result property="condition" column="condition" />
            <result property="status" column="status" />
            <result property="expireTime" column="expire_time" />
    </resultMap>
    <select id="selectCouponUserVO" resultType="com.guchen.pojo.CouponUserVO" parameterType="java.lang.Long">
        select u.id, c.name, c.value, c.condition, u.expire_time, u.status
        from coupon_user u
        left join coupon c
        on u.coupon_id = c.id
        <where>
            <if test="userID != null and userID != ''">
                u.user_id = #{userID};
            </if>
        </where>
    </select>


</mapper>
